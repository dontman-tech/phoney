[Unit]
Description=Phoney — Android companion via KDE Connect protocol
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/phoney daemon
Restart=on-failure
RestartSec=5
# The dashboard binds 127.0.0.1:3000 only — no broad exposure.

[Install]
WantedBy=default.target
